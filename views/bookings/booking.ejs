<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-md-6">
        <div class="p-3">
            <h2 style="font-size: 1.75rem; font-weight: 600;">Booking confirmed!</h2>
            <div class="card show-card listing-card mt-3">
                <div class="card-body">
                    <h3 class="card-text plus-jakarta-sans-font" style="font-weight: 700; font-size: 1.25rem;">Your trip</h3>
                    <div class="booking-details-row mt-3">
                        <p class="card-text plus-jakarta-sans-font" style="font-size: 1rem;"><b>Dates</b><br><%= booking.checkIn.toDateString().substring(4) %> - <%= booking.checkOut.toDateString().substring(4) %></p>
                    </div>
                    <div class="booking-details-row mt-3">
                        <p class="card-text plus-jakarta-sans-font" style="font-size: 1rem;"><b>Guests</b><br><%= booking.guests %></p>
                    </div>
                    <hr>
                    <h3 class="card-text plus-jakarta-sans-font mt-3" style="font-weight: 700; font-size: 1.25rem;">Ground rules</h3>
                    <div class="mt-3">
                        <p class="card-text plus-jakarta-sans-font" style="font-size: 0.9rem; color: #555;">We ask every guest to remember a few simple things about what makes a great guest.<br><br>&middot; Follow the house rules<br>&middot; Treat your Host's home like your own</p>
                    </div>
                    <hr>
                    <h2 class="mt-3" style="font-size: 1.5rem; text-align: center;">Thank you for booking</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="property-card mt-3" style="position: sticky; top: 90px;">
            <div class="property-header">
                <div class="property-image">
                    <img src="<%= booking.listing.image.url %>" alt="Listing Image" style="width: 100px; height: 100px; border-radius: 8px; object-fit: cover;">
                </div>
                <div class="property-info">
                    <p class="property-type mb-1" style="font-size: 0.85rem; color: #666;">Entire rental unit</p>
                    <h2 class="property-title" style="font-size: 1.1rem; font-weight: 500;"><%= booking.listing.title %></h2>
                </div>
            </div>
            <%
                const checkIn = new Date(booking.checkIn);
                const checkOut = new Date(booking.checkOut);
                const oneDay = 1000 * 60 * 60 * 24;
                const nights = Math.round((checkOut.getTime() - checkIn.getTime()) / oneDay);
                const price = booking.totalPrice;
                const tax = Math.round(0.18 * price);
                const totalPrice = price + tax;
            %>
            <div class="total-section">
                <h3 class="total-title">Your total</h3>
                <div class="price-details">
                    <div class="price-row">
                        <span class="price-label">₹<%= booking.listing.price.toLocaleString("en-IN") %> x <%= nights %> nights</span>
                        <span class="price-value">₹<%= price.toLocaleString("en-IN") %></span>
                    </div>
                    <div class="price-row">
                        <span class="price-label">Taxes (18%)</span>
                        <span class="price-value">₹<%= tax.toLocaleString("en-IN") %></span>
                    </div>
                </div>
                <div class="total-row">
                    <span class="total-label">Total (INR)</span>
                    <span class="total-amount">₹<%= totalPrice.toLocaleString("en-IN") %></span>
                </div>
            </div>
        </div>
    </div>
</div>